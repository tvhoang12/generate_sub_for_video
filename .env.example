# Copy to .env and fill in. Restart the server after changes.

# Translator: gemini | claude | openai | mock (mock = fake translations, for testing only)
TRANSLATOR_PROVIDER=gemini

# Google Gemini (Gemini 5.5 Flash Lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — higher is more careful and more expensive
CLAUDE_EFFORT=medium

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional overrides
# DATA_DIR=E:/Claude/sub_videos/data
# FUNASR_MODEL=iic/SenseVoiceSmall
# FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
# FUNASR_DEVICE=cpu
# FUNASR_THREADS=4
# MODELS_DIR=/data/models
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# MAX_CUE_SECONDS=7
# VIDEO_CRF=20
