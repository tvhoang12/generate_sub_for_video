# Copy to .env and fill in. Restart the server after changes.

# Translator: gemini | claude | openai | mock (mock = fake translations, for testing only)
TRANSLATOR_PROVIDER=gemini

# Google Gemini (Gemini 3.1 Flash Lite / 3.5 Flash Lite / 3.6 Flash)
GEMINI_API_KEY=
# GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — higher is more careful and more expensive
CLAUDE_EFFORT=medium

# OpenAI (gpt-4o-mini: nhanh & tiết kiệm, gpt-4o: chất lượng cao nhất)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional overrides
# DATA_DIR=E:/Claude/sub_videos/data
# FUNASR_MODEL=iic/SenseVoiceSmall
# FUNASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
# FUNASR_DEVICE=cpu
# FUNASR_THREADS=4
# MODELS_DIR=/data/models
# FUNASR_MERGE_VAD=false            # false: tách theo nhịp ngắt nghỉ của nhân vật thay vì gom cả câu
# FUNASR_MERGE_LENGTH_S=4           # độ dài gộp tối đa nếu bật merge_vad (mặc định 4s)
# FUNASR_VAD_MAX_SILENCE_MS=450     # ngưỡng im lặng ngắt nhịp (ms), nhân vật dừng 0.45s sẽ tách câu mới
# FUNASR_VAD_MAX_SEGMENT_MS=5000    # độ dài tối đa 1 phân đoạn âm thanh (5000ms = 5s)
# FUNASR_VAD_SPEECH_NOISE_THRES=0.8
# MAX_CUE_SECONDS=4.0               # thời lượng hiển thị tối đa của 1 dòng sub (mặc định 4.0s)
# VIDEO_CRF=20
# VIDEO_PRESET=veryfast
# FFMPEG_THREADS=16
# FFMPEG_FILTER_THREADS=4
# GEMINI_BATCH_SIZE=70
# GEMINI_CONCURRENCY=2
# GEMINI_RPM_LIMIT=14

# ==============================================================================
# PATHS
# ==============================================================================
# Thư mục lưu file upload tạm thời (sẽ tự động xóa sau khi encode hoàn tất)
# UPLOAD_DIR=./uploads
# HLS_UPLOAD_DIR=./uploads
# Thư mục lưu file HLS output (phân vùng mount riêng biệt)
# HLS_STORAGE_PATH=/var/www/hls
# OUTPUT_DIR=/var/www/hls

# ==============================================================================
# CẤU HÌNH 2 HÀNG ĐỢI ĐỘC LẬP (INDEPENDENT WORKER QUEUES)
# ==============================================================================
# Hàng đợi 1: Tạo phụ đề (Subtitle Pipeline)
# FFMPEG_THREADS=8                # Số luồng CPU cho ffmpeg tách âm thanh / gắn sub
# FUNASR_THREADS=4                # Số luồng CPU cho FunASR nhận diện giọng nói

# Hàng đợi 2: Chuyển đổi HLS (HLS Converter Queue - chạy riêng biệt)
# HLS_MAX_CONCURRENT=1            # Số lượng video HLS encode đồng thời (mặc định: 1)
# HLS_FFMPEG_THREADS=4            # Số luồng CPU dành riêng cho ffmpeg HLS (tránh nghẽn CPU)
# HLS_PRESET=veryfast             # Preset encode HLS (veryfast, fast, medium)
# HLS_SEGMENT_DURATION=6          # Thời lượng mỗi segment HLS (giây)
# HLS_KEYINT=48                   # Keyframe interval
