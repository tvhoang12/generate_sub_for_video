# Copy to .env and fill in. Restart the server after changes.

# Translator: claude | openai | mock (mock = fake translations, for testing only)
TRANSLATOR_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — higher is more careful and more expensive
CLAUDE_EFFORT=medium

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5



# Optional overrides
# DATA_DIR=E:/Claude/sub_videos/data
# WHISPER_DIR=E:/Claude/sub_videos/tools/whisper
# WHISPER_THREADS=8
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# MAX_CUE_SECONDS=7
# VIDEO_CRF=20
